<Page
    x:Class="OpenMono.Windows.Desktop.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*,Auto,Auto" Padding="16">
        <ListView x:Name="Messages" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <AutoSuggestBox x:Name="Input" Grid.Row="1" Margin="0,8,0,0"
            PlaceholderText="Ask OpenMono (try / for commands)"
            TextChanged="Input_TextChanged"
            QuerySubmitted="Input_QuerySubmitted"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Send" Click="Send_Click"/>
            <Button Content="Stop" Click="Stop_Click"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>
    </Grid>
</Page>
