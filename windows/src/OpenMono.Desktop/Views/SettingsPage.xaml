<Page
    x:Class="OpenMono.Windows.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="8">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Endpoint override (dual box client mode). Leave empty for local inference."/>
            <TextBox x:Name="EndpointBox" PlaceholderText="http://127.0.0.1:7474"/>
            <CheckBox x:Name="DockerBox" Content="Enable Docker web services (Caddy, SearXNG, Scrapling)"/>
            <CheckBox x:Name="VisionBox" Content="Vision (mmproj) enabled"/>
            <CheckBox x:Name="AcpBox" Content="Loopback ACP for editors (127.0.0.1:7475)"/>
            <TextBlock Text="Workspace folder"/>
            <TextBox x:Name="WorkspaceBox"/>
            <TextBlock Text="Models folder"/>
            <TextBox x:Name="ModelsBox"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Click="Save_Click"/>
                <Button Content="Check for updates" Click="Update_Click"/>
            </StackPanel>
            <TextBlock x:Name="Note" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
