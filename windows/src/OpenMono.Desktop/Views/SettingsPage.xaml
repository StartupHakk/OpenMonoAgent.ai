<Page
    x:Class="OpenMono.Windows.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="8">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Endpoint override (dual box client mode). Leave empty for local inference."/>
            <TextBox x:Name="EndpointBox" PlaceholderText="http://127.0.0.1:7474"/>
            <CheckBox x:Name="DockerBox" Content="Enable Docker web services (Caddy, SearXNG, Scrapling)"/>
            <CheckBox x:Name="VisionBox" Content="Vision (mmproj) enabled"/>
            <CheckBox x:Name="AcpBox" Content="Loopback ACP for editors (127.0.0.1:7475)"/>
            <TextBlock Text="Workspace folder"/>
            <TextBox x:Name="WorkspaceBox"/>
            <TextBlock Text="Models folder"/>
            <TextBox x:Name="ModelsBox"/>
            <TextBlock Text="LAN inference (serve this machine's model to other machines)" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ToggleSwitch x:Name="LanBox" Header="Allow LAN connections" OffContent="Localhost only" OnContent="Serve on LAN"/>
            <PasswordBox x:Name="ApiKeyBox" Header="LAN API key (required when serving on LAN)" PlaceholderText="Auto-generated when you enable LAN"/>
            <Button Content="Generate new API key" Click="GenerateKey_Click"/>
            <TextBlock x:Name="LanUrlText" TextWrapping="Wrap"/>
            <TextBlock Text="LAN clients connect to one of the URLs above and send the API key as a Bearer token. When Windows Firewall prompts, allow OpenMono on private networks. Never expose this port to the internet without a tunnel." TextWrapping="Wrap" Opacity="0.7"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Click="Save_Click"/>
                <Button Content="Check for updates" Click="Update_Click"/>
            </StackPanel>
            <TextBlock x:Name="Note" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
