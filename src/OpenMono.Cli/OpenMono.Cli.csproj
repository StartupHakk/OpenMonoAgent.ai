<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenMono</RootNamespace>
    <AssemblyName>openmono</AssemblyName>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenMono.Core\OpenMono.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="Spectre.Console.Json" Version="0.50.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Terminal.Gui" Version="2.0.0-develop.5264" />
    <PackageReference Include="TiktokenSharp" Version="1.2.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- The base SkiaSharp package only ships macOS/Windows native assets.
         On Linux (the agent Docker image) libSkiaSharp.so would be missing and
         image compression would throw DllNotFoundException. The NoDependencies
         variant bundles a self-contained .so with no libfontconfig1 need. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenMono.Tests" />
  </ItemGroup>

</Project>
