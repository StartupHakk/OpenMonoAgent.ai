cmd_setup() {
    # Sub-targets: install an individual optional service onto an existing box.
    case "${1:-}" in
        gateway)           shift; _setup_gateway "$@"; return $? ;;
        search)            shift; cmd_setup_search "$@"; return $? ;;
        scraper|scrapper)  shift; cmd_setup_scraper "$@"; return $? ;;
    esac

    # Parse flags
    for arg in ${1+"$@"}; do
        case "$arg" in
            --gpu)          export OPENMONO_GPU=1 ;;
            --cpu)          export OPENMONO_CPU=1 ;;
            --inference)    export OPENMONO_ROLE=inference ;;
            --agent)        export OPENMONO_ROLE=agent ;;
            --full)         export OPENMONO_ROLE=full ;;
            --model=*)      export OPENMONO_MODEL="${arg#--model=}" ;;
            --vision=*)     export OPENMONO_VISION="${arg#--vision=}" ;;
            --bonsai)       export OPENMONO_MODEL=bonsai-pq2 ;;
            --bonsai-ptq1)  export OPENMONO_MODEL=bonsai-ptq1 ;;
            --qwen)         export OPENMONO_MODEL=qwen ;;
            --flash-next)   export OPENMONO_MODEL=flash-next ;;
            --options)      export OPENMONO_SETUP_OPTIONS=1 ;;
            --verbose|-v)   export OPENMONO_VERBOSE=1 ;;
            --help|-h)
                echo "Usage: openmono setup [--full|--inference|--agent] [--gpu|--cpu] [--model=NAME] [--vision=on|off] [--options] [--verbose]"
                echo ""
                echo "Installs one of three roles. Pick based on what the box will do:"
                echo ""
                echo "  --full        DEFAULT. Agent + inference server + model on one machine."
                echo "                Use when you have a single workstation."
                echo "  --inference   Inference server + model only (no agent). Use on the GPU box"
                echo "                in dual-box mode. Pair with 'openmono tunnel setup' to"
                echo "                expose it through an OpenMono.Relay."
                echo "  --agent       Agent + code-review-graph only (no model, no inference server)."
                echo "                Use on the laptop in dual-box mode. Point at a remote"
                echo "                inference server via 'openmono config set llm.endpoint …'."
                echo ""
                echo "Model engine — by default setup picks the BEST model your hardware can run and does not ask:"
                echo "  24GB+ VRAM + 48GB-class RAM → Qwen3.8-Flash-Next (Strata)   24GB+ VRAM, less RAM → Qwen3.8-27B"
                echo "  16GB VRAM → Qwen3.8-27B IQ3_XXS          12GB VRAM / AMD iGPU (32GB+ RAM) → Bonsai PQ2_0"
                echo "  CPU only → Qwen3.6-35B-A3B              macOS 48GB+ → Qwen3.6-35B-A3B · 24-47GB → PQ2_0 · 16-23GB → PTQ1_0"
                echo "  (full table: docs/MODELS.md). Pass --options to choose model, vision and parallel slots yourself."
                echo ""
                echo "Override the pick with any of:"
                echo "  --model=qwen         Stock Qwen on standard llama.cpp"
                echo "  --model=bonsai-pq2   Ternary-Bonsai-2-27B PQ2_0 (~7.2GB) [NVIDIA CUDA / AMD iGPU Vulkan / Apple Silicon]"
                echo "  --model=bonsai-ptq1  Ternary-Bonsai-2-27B PTQ1_0 (~5.9GB, tightest memory)"
                echo "  --model=flash-next   Qwen3.8-Flash-Next via Strata (~70GB, Linux + NVIDIA / CUDA 13, 48GB-class RAM+)"
                echo "  --bonsai / --bonsai-ptq1 / --qwen / --flash-next   shorthands for the above"
                echo ""
                echo "GPU mode (applies to --full and --inference):"
                echo "  --gpu         Force GPU mode (requires NVIDIA + nvidia-container-toolkit)"
                echo "  --cpu         Force CPU mode"
                echo ""
                echo "Other:"
                echo "  --options     Ask about model, vision and parallel slots instead of defaulting them from"
                echo "                hardware. Role, GPU mode, host-bridge consent and reboot still always ask."
                echo "  --verbose     Show detailed command output (default: step-level progress)"
                echo "  OPENMONO_DOTNET_UPDATE=0  Skip upgrading an older .NET SDK (setup prompts;"
                echo "                non-interactive installs upgrade automatically to the patched SDK)."
                echo ""
                echo "Server sub-agent (opt-in add-on, full/agent only — never inference):"
                echo "  Setup asks once (default No, breaks container sandbox when installed)."
                echo "  On Yes it asks again: ask-every-time (default) vs allow-routine."
                echo "  For non-interactive installs:"
                echo "    OPENMONO_HOST_BRIDGE=1 OPENMONO_HOST_EXEC_DEFAULT=ask openmono setup --agent     # confirm each host cmd"
                echo "    OPENMONO_HOST_BRIDGE=1 OPENMONO_HOST_EXEC_DEFAULT=allow openmono setup --agent   # routine runs without asking"
                echo "    OPENMONO_HOST_BRIDGE=0 openmono setup --agent   # skip the prompt (default)"
                echo "  Add it later any time with: bash scripts/install-host-bridge.sh"
                echo ""
                echo "A full log is written to ~/.openmono/logs/setup-<timestamp>.log"
                echo ""
                echo "Dual-box flow:"                
                echo "  Inference box: openmono setup --inference"
                echo "                 openmono start"
                echo "                 openmono tunnel setup"
                echo "  Agent box:     openmono setup --agent"
                echo "                 openmono config set llm.endpoint http://<frpsAddress>:<remotePort>"
                echo "                 openmono config set llm.api_key <llama_api_key>"
                echo "                 openmono agent"
                return 0
                ;;
        esac
    done

    source "$REPO_DIR/scripts/lib/log.sh"

    if [[ -n "${OPENMONO_HOME:-}" ]]; then
        INSTALL_DIR="$OPENMONO_HOME"
    else
        INSTALL_DIR="$REPO_DIR"
    fi

    source "$REPO_DIR/scripts/lib/shell-integration.sh" 2>/dev/null || true
    info "Setting up shell integration..."
    if install_to_system_path "$INSTALL_DIR"; then
        ok "Command available system-wide: /usr/local/bin/openmono"
    else
        if setup_shell_integration "$INSTALL_DIR"; then
            ok "Added to shell rc files"
        else
            warn "Could not auto-configure shell integration"
            print_setup_instructions "$INSTALL_DIR"
        fi
    fi

    role_prompt

    export OPENMONO_LOG_DIR="${OPENMONO_LOG_DIR:-$HOME/.openmono/logs}"
    mkdir -p "$OPENMONO_LOG_DIR"
    export OPENMONO_LOG_FILE="$OPENMONO_LOG_DIR/setup-$(date +%Y%m%d-%H%M%S).log"
    : > "$OPENMONO_LOG_FILE"

    _OS=$(uname -s)
    case "$_OS" in
        Darwin)
            _PREREQS_SCRIPT="$REPO_DIR/scripts/install_prereqs_macos.sh"
            _INSTALL_SCRIPT="$REPO_DIR/scripts/install_macos.sh"
            ;;
        Linux)
            _PREREQS_SCRIPT="$REPO_DIR/scripts/install_prereqs.sh"
            _INSTALL_SCRIPT="$REPO_DIR/scripts/install.sh"
            if command -v docker &>/dev/null && ! docker info &>/dev/null 2>&1 && id -nG 2>/dev/null | grep -qw docker; then
                exec sg docker "$0" setup "$@"
            fi
            ;;
        *)
            err "Unsupported OS: $_OS (supported: Linux, macOS/Darwin)"
            exit 1
            ;;
    esac

    export OPENMONO_ENV_FILE="$HOME/.openmono/.tmp_install_env"
    mkdir -p "$(dirname "$OPENMONO_ENV_FILE")"
    : > "$OPENMONO_ENV_FILE"

    bash "$_PREREQS_SCRIPT" 2>> "$OPENMONO_LOG_FILE" || {
        echo ""
        show_log_tail 30
        err "Prerequisite install failed. Full log: $OPENMONO_LOG_FILE"
        exit 1
    }

    if [[ -z "${OPENMONO_GPU:-}" && -f "$HOME/.openmono/.tmp_gpu_mode" ]]; then
        _gpu_val=$(grep '^GPU_MODE=' "$HOME/.openmono/.tmp_gpu_mode" | cut -d= -f2 | tr -d '[:space:]')
        [[ "$_gpu_val" == "1" ]] && export OPENMONO_GPU=1 || export OPENMONO_GPU=0
        rm -f "$HOME/.openmono/.tmp_gpu_mode"
    fi

    bash "$_INSTALL_SCRIPT" 2>> "$OPENMONO_LOG_FILE" || {
        echo ""
        show_log_tail 30
        err "Installation failed. Full log: $OPENMONO_LOG_FILE"
        exit 1
    }

    if [[ -n "${OPENMONO_ENV_FILE:-}" ]] && [[ -f "$OPENMONO_ENV_FILE" ]]; then

        source "$OPENMONO_ENV_FILE"
    fi

    INSTALL_DIR="${INSTALL_DIR:-$HOME/openmono.ai}"
    INFERENCE_PORT="${INFERENCE_PORT:-${LLAMA_PORT:-${STRATA_PORT:-7474}}}"
    local settings_dir="$HOME/.openmono"
    local settings_file="$settings_dir/settings.json"
    mkdir -p "$settings_dir"
    if [[ ! -f "$settings_file" ]]; then
        if [[ "${OPENMONO_ROLE:-}" == "agent" ]]; then
             cat > "$settings_file" <<'EOF'
{
  "llm": {
    "endpoint": "",
    "api_key": ""
  }
}
EOF
            detail "Created $settings_file for agent-only role (configure endpoint with: openmono config set llm.endpoint <url>)"
        else
            _default_endpoint="http://localhost:${INFERENCE_PORT}"
            cat > "$settings_file" <<EOF
{
  "llm": {
    "endpoint": "$_default_endpoint",
    "api_key": ""
  }
}
EOF
            detail "Created $settings_file with defaults"
        fi
    fi

    prompt_optional_services
    echo ""
    printf "${BLUE}%s${NC}\n" "$(printf '─%.0s' $(seq 1 60))"
    printf "${BLUE}${BOLD}  Setup Complete${NC} (role: %s)\n" "$OPENMONO_ROLE"
    printf "${BLUE}%s${NC}\n" "$(printf '─%.0s' $(seq 1 60))"
    echo ""
    echo -e "  ${GREEN}✓${NC} OpenMono.ai is ready to use!"
    echo ""

    case "$OPENMONO_ROLE" in
        full|inference)
            if [[ "${OPENMONO_INFERENCE_BACKEND:-}" == "strata" && "$NATIVE_INFERENCE" != "true" ]]; then
                echo "  strata endpoint : http://localhost:${INFERENCE_PORT}"
                echo "  mode            : Strata (Qwen3.8-Flash-Next, host-native)"
            else
                echo "  llama-server port : ${INFERENCE_PORT}"
                if [[ "$NATIVE_INFERENCE" == "true" ]]; then
                    echo "  mode              : Metal GPU (native llama.cpp)"
                else
                    echo "  mode              : $([ "${GPU_MODE:-0}" = "1" ] && echo GPU || echo CPU)"
                fi
            fi
            echo ""
            ;;
    esac

    case "$OPENMONO_ROLE" in
        full)
            echo "  Your machine is configured for single-box mode (agent + inference)."
            echo ""
            echo "  Next steps:"
            echo -e "    1. ${BOLD}cd your-project/${NC}"
            echo -e "    2. ${BOLD}openmono agent${NC}                 # Start the agent"
            echo ""
            echo "  Other commands:"
            echo -e "    ${BOLD}openmono status${NC}              # Show inference backend status"
            echo -e "    ${BOLD}openmono config${NC}             # Configure settings"
            echo ""
            ;;
        inference)
            echo "  Your machine is configured as the inference server."
            echo ""
            echo "  Next steps:"
            echo -e "    1. ${BOLD}openmono tunnel setup${NC}       # Connect to openmonoagent.ai relay"
            echo -e "    2. Use the endpoint + API key from step 1 on your agent box"
            echo ""
            echo "  Other commands:"
            echo -e "    ${BOLD}openmono start${NC}              # Start inference backend"
            echo -e "    ${BOLD}openmono status${NC}             # Show server status"
            echo -e "    ${BOLD}openmono logs${NC}               # Tail server logs"
            echo ""
            ;;
        agent)
            echo "  Your machine is configured as the agent (dual-box mode)."
            echo ""
            echo "  ${BOLD}⚠ This box has no inference endpoint yet.${NC} On the inference box, run:"
            echo ""
            echo -e "    ${BOLD}openmono tunnel setup${NC}     # connect it to the openmonoagent.ai relay"
            echo ""
            echo "  That prints the endpoint + API key to use here. Configure this box with:"
            echo ""
            echo -e "    ${BOLD}openmono config set llm.endpoint  http://relay.openmonoagent.ai:<port>${NC}"
            echo -e "    ${BOLD}openmono config set llm.api_key   <key from tunnel setup>${NC}"
            echo ""
            echo "  Then run the agent:"
            echo -e "    ${BOLD}cd your-project/${NC}"
            echo -e "    ${BOLD}openmono agent${NC}"
            echo ""
            ;;
    esac

    if [[ "${OPENMONO_HOST_BRIDGE:-0}" == "1" ]]; then
        echo "  Bare-metal host access installed (opt-in add-on)."
        echo ""
        echo "  The agent stays sandboxed; a host-bridge daemon on this box runs"
        echo "  host commands (pull, build, install, redeploy, troubleshoot)"
        echo "  behind a HOST EXECUTION card, audited and policy-gated:"
        echo ""
        echo -e "    ${BOLD}cd your-project/ && openmono agent --host${NC}   # run the agent with host access (daemon auto-starts)"
        echo -e "    ${BOLD}openmono host status${NC}                       # check the daemon (start: openmono host daemon)"
        echo -e "    ${BOLD}openmono host stop${NC}                         # stop the daemon"
        echo ""
        echo "  Or keep the agent sandboxed and pair on demand: start the daemon"
        echo "  with ${BOLD}openmono host daemon${NC}, then run ${BOLD}/host on${NC} inside the agent."
        echo ""
        echo "  Host policy (change any time, stored in ~/.openmono/host-bridge.json):"
        echo -e "    ${BOLD}openmono config set host.sudo_policy ask|allow|deny${NC}"
        echo -e "    ${BOLD}openmono config set host.exec_default ask|allow${NC}"
        echo ""
    fi

    echo "  Troubleshooting:"
    echo "    If you exit before the shell reloads, reload it manually:"
    echo -e "      ${BOLD}exec -l \$SHELL${NC}    # Reload login shell (picks up new groups + PATH)"
    echo ""
    echo "  Full help: openmono --help"
    printf "${BLUE}%s${NC}\n" "$(printf '─%.0s' $(seq 1 60))"
    echo ""
    show_log_location

    rm -f "$HOME/.openmono/.setup_prefs"

    unset OPENMONO_GPU OPENMONO_CPU OPENMONO_ROLE OPENMONO_VERBOSE OPENMONO_LOG_DIR \
          OPENMONO_LOG_FILE OPENMONO_ENV_FILE GPU_MODE AMD_IGPU_MODE AMD_IGPU_REBOOT_PENDING \
          INSTALL_DIR INFERENCE_PORT LLAMA_PORT STRATA_PORT OPENMONO_VERBOSE OPENMONO_HOST_BRIDGE
    export PATH="$INSTALL_DIR:$PATH"
    exec -l "$SHELL"
}

cmd_start() {
    # Materialize settings.json into the backend files. If the running backend
    # is out of sync (port/slots/key changed), stop it first using applied state.
    local _drift=0
    _inference_settings_drift || _drift=$?
    if [[ "$_drift" == "2" ]]; then
        info "Inference settings changed — restarting the backend to apply them."
        _stop_inference_backend_applied
    fi
    _apply_inference_settings

    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        native_cmd_start || return $?
        _start_web_services || true
        echo ""
        echo "  Run the agent: openmono agent"
        return 0
    fi

    # Strata backend: host-native server via scripts/strata.sh (no Docker).
    if [[ "$(_inference_backend)" == "strata" ]]; then
        bash "$REPO_DIR/scripts/strata.sh" start || return $?
        _start_web_services || true
        echo ""
        echo "  Run the agent: openmono agent"
        return 0
    fi

    _ensure_docker
    cd "$DOCKER_DIR"
    export INFERENCE_PORT
    if ss -tlnp 2>/dev/null | grep -q ":${INFERENCE_PORT} "; then
        if _inference_curl -sf "http://localhost:${INFERENCE_PORT}/health" &>/dev/null; then
            ok "llama-server already running on port ${INFERENCE_PORT}"
            echo "  Run the agent: openmono agent"
            return
        fi
        err "Port ${INFERENCE_PORT} is in use by another process. Change it with: openmono config set inference.port <port>"
        exit 1
    fi
    info "Starting llama-server on port ${INFERENCE_PORT}..."
    docker compose up -d llama-server

    info "Waiting for llama-server to be healthy (model load can take 1-3 min)..."
    HEALTHY=false
    for i in $(seq 1 36); do
        if _inference_curl -sf "http://localhost:${INFERENCE_PORT}/health" &>/dev/null; then
            echo ""
            ok "llama-server is healthy on port ${INFERENCE_PORT}"
            HEALTHY=true
            break
        fi
        sleep 5
        echo -n "."
    done

    if [ "$HEALTHY" = false ]; then
        echo ""
        warn "Not healthy yet — model may still be loading."
        warn "Check progress: openmono logs"
    else
        echo ""
        echo "  Run the agent: openmono agent"
    fi

    _start_web_services || true
}

# Inventory for bare `openmono stop`: everything actually running relative
# to OMA, so the operator confirms against reality instead of assumptions.
_stop_inventory() {
    echo ""
    echo "Running OpenMono pieces:"
    if [[ "$(_inference_backend)" == "strata" ]]; then
        if pgrep -f 'strata' &>/dev/null; then
            echo "  - Strata inference server (host-native) — stop with: openmono stop"
        else
            echo "  - Strata inference server: not running"
        fi
    elif [[ "$NATIVE_INFERENCE" == "true" ]]; then
        # Show the applied port (not a freshly edited settings.json value).
        local nport; nport="$(_applied_inference_port)"
        if _inference_curl -sf "http://localhost:${nport}/health" &>/dev/null; then
            echo "  - llama-server (native, Metal) on port ${nport}"
        else
            echo "  - llama-server (native): not responding on port ${nport}"
        fi
    else
        if _inference_curl -sf "http://localhost:${INFERENCE_PORT}/health" &>/dev/null; then
            echo "  - llama-server (docker) healthy on port ${INFERENCE_PORT}"
        else
            echo "  - llama-server (docker): not responding"
        fi
    fi
    if docker info &>/dev/null 2>&1; then
        local running
        running="$(cd "$DOCKER_DIR" && docker compose ps --format '{{.Service}} ({{.State}})' 2>/dev/null | grep -v '^$' || true)"
        if [[ -n "$running" ]]; then
            echo "$running" | while IFS= read -r line; do echo "  - $line"; done
        else
            echo "  - no compose services running"
        fi
        local extra
        extra="$(docker ps -a --filter 'name=openmono-host-bridge' --filter 'name=openmono-agent' \
            --format '{{.Names}} ({{.State}})' 2>/dev/null || true)"
        if [[ -n "$extra" ]]; then
            echo "$extra" | while IFS= read -r line; do echo "  - $line [agent container — kept unless --agent-host/--agent]"; done
        fi
        if pgrep -f 'host-bridge' &>/dev/null; then
            echo "  - host-bridge process is LIVE (stop it with Ctrl-C / /quit first — stop never kills it)"
        fi
    else
        echo "  - Docker daemon not accessible — container state unknown"
    fi
    echo ""
}

cmd_stop() {
    # Selectors: default = full compose stack (llama + gateway + search +
    # scraper). Run-created agent containers are NEVER touched by default —
    # stopping those would kill someone's live `openmono agent` session in
    # another terminal. Ask for them explicitly (--agent-host, --agent) or
    # take everything with --all.
    local sel_llama=false sel_gateway=false sel_search=false sel_scraper=false
    local sel_bridge=false sel_agent=false sel_all=false rm_orphans=false
    local a
    for a in ${1+"$@"}; do
        case "$a" in
            --llama) sel_llama=true ;;
            --gateway) sel_gateway=true ;;
            --search) sel_search=true ;;
            --scraper) sel_scraper=true ;;
            --agent-host) sel_bridge=true ;;
            --agent) sel_agent=true ;;
            --all) sel_all=true ;;
            --remove-orphans) rm_orphans=true ;;
            -h|--help)
                echo "Usage: openmono stop [--llama] [--gateway] [--search] [--scraper] [--agent-host] [--agent] [--all] [--remove-orphans]"
                echo ""
                echo "  (no flags)   Stop the full compose stack: llama-server + gateway/search/scraper."
                echo "  --agent-host  Also remove the openmono-host-bridge container (agent --host)."
                echo "                Stop the host-bridge process itself with Ctrl-C / /quit first."
                echo "  --agent       Also remove live openmono-agent run containers (sandbox sessions)."
                echo "  --all         Everything above + 'compose down --remove-orphans'."
                return 0 ;;
            *)
                err "Unknown flag for stop: $a (see: openmono stop --help)"
                return 1 ;;
        esac
    done
    if [[ "$sel_all" == "true" ]]; then
        sel_llama=true; sel_gateway=true; sel_search=true; sel_scraper=true
        sel_bridge=true; sel_agent=true
    elif [[ "$sel_llama" == "false" && "$sel_gateway" == "false" && \
            "$sel_search" == "false" && "$sel_scraper" == "false" && \
            "$sel_bridge" == "false" && "$sel_agent" == "false" ]]; then
        sel_llama=true; sel_gateway=true; sel_search=true; sel_scraper=true
    fi
    local no_flags=true
    [[ "$sel_bridge" == "true" || "$sel_agent" == "true" || "$sel_all" == "true" || \
       "$sel_llama" == "false" || "$sel_gateway" == "false" || \
       "$sel_search" == "false" || "$sel_scraper" == "false" ]] && no_flags=false
    # Bare `openmono stop`: show everything actually running relative to OMA
    # and require confirmation. Explicit flags proceed without asking.
    if [[ "$no_flags" == "true" ]]; then
        if [[ -t 0 ]]; then
            _stop_inventory
            local confirm=""
            read -r -p "Stop all of the above? [y/N] " confirm || confirm=""
            case "$confirm" in
                [yY]|[yY]es) ;;
                *)
                    info "Aborted — nothing stopped. Target pieces explicitly, e.g.: openmono stop --llama"
                    return 0 ;;
            esac
        else
            info "Non-interactive — proceeding with the full compose stack (no agent containers)."
        fi
    fi

    local rc=0

    # Native inference (macOS): never early-return. A dead llama-server must
    # not skip the compose cleanup below — that ordering bug used to leave
    # gateway/search/scraper running forever after `openmono stop`.
    local backend; backend="$(_inference_backend)"

    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        if [[ "$sel_llama" == "true" ]]; then
            OPENMONO_APPLIED_PORT="$(_applied_inference_port)" native_cmd_stop || { warn "native llama-server stop failed — continuing with containers."; rc=1; }
        fi
    elif [[ "$backend" == "strata" ]]; then
        # Strata serves host-native (it is not a compose service): stop it via its
        # manager. The gateway/agent containers are still torn down below.
        if [[ "$sel_llama" == "true" ]]; then
            bash "$REPO_DIR/scripts/strata.sh" stop || { warn "Strata stop failed — continuing with containers."; rc=1; }
        fi
    else
        _ensure_docker
        if [[ "$sel_llama" == "true" ]]; then
            if ! _inference_curl -sf "http://localhost:${INFERENCE_PORT}/health" &>/dev/null; then
                warn "llama-server is not responding on port ${INFERENCE_PORT}"
            fi
        fi
    fi

    if docker info &>/dev/null 2>&1; then
        cd "$DOCKER_DIR"
        export INFERENCE_PORT
        # Explicit service names bypass compose profile filtering, so every
        # selected service is stopped regardless of which profiles started it.
        local svcs=()
        [[ "$sel_llama" == "true" && "$backend" != "strata" ]] && svcs+=(llama-server)
        [[ "$sel_gateway" == "true" ]] && svcs+=(caddy)
        [[ "$sel_search" == "true" ]] && svcs+=(searxng)
        [[ "$sel_scraper" == "true" ]] && svcs+=(scrapling)
        if [[ ${#svcs[@]} -gt 0 ]]; then
            info "Stopping ${svcs[*]}..."
            if docker compose stop "${svcs[@]}" 2>/dev/null; then
                ok "Stopped: ${svcs[*]}"
            else
                warn "Some services did not stop cleanly — check: docker compose ps"
                rc=1
            fi
        fi
        # Run-created containers are invisible to `compose down` (they come
        # from `compose run -d --name`, not `up`), so remove them by name.
        # `rm -f` on a non-existent name is a silent no-op success.
        if [[ "$sel_bridge" == "true" ]]; then
            if docker rm -f openmono-host-bridge 2>/dev/null; then
                ok "Removed openmono-host-bridge container"
            else
                info "No openmono-host-bridge container to remove"
            fi
        fi
        if [[ "$sel_agent" == "true" ]]; then
            if docker rm -f openmono-agent 2>/dev/null; then
                ok "Removed openmono-agent container"
            else
                info "No openmono-agent container to remove"
            fi
        fi
        # Full-stack selections finish with `down` (previous behaviour): this
        # removes stopped containers + the project network. Subset selections
        # only stop, so unrelated services keep running.
        if [[ "$sel_llama" == "true" && "$sel_gateway" == "true" && \
              "$sel_search" == "true" && "$sel_scraper" == "true" ]]; then
            if [[ "$rm_orphans" == "true" || "$sel_all" == "true" ]]; then
                docker compose down --remove-orphans 2>/dev/null || rc=1
            else
                docker compose down 2>/dev/null || rc=1
            fi
        fi
        if [[ "$rc" == "0" ]]; then
            ok "Stop complete — verify: docker compose ps"
        else
            warn "Stop finished with warnings — verify: docker compose ps"
        fi
    else
        warn "Docker daemon is not accessible — native processes (if any) handled above; containers untouched."
        rc=1
    fi
    return $rc
}

cmd_restart() {
    # Stop using applied state, materialize settings, then start. Applying before
    # cmd_start avoids a second (noisy) stop in its drift check.
    _stop_inference_backend_applied
    _apply_inference_settings
    cmd_start
}

_refresh_update_cache() {
    local cache="$HOME/.openmono/.update_check" notice=""
    git -C "$REPO_DIR" fetch --quiet 2>/dev/null || true
    local upstream behind cur
    upstream="$(git -C "$REPO_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    if [[ -n "$upstream" ]]; then
        behind="$(git -C "$REPO_DIR" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)"
        if [[ "${behind:-0}" -gt 0 ]]; then
            cur="$(cat "$REPO_DIR/VERSION" 2>/dev/null | tr -d '[:space:]')"
            notice="Update available — ${behind} new commit(s). Exit and run: openmono upgrade  (you're on v${cur:-?})"
        fi
    fi
    mkdir -p "$HOME/.openmono"
    printf '%s\n%s\n' "$(date +%s)" "$notice" > "$cache"
}

_update_notice() {
    [[ -d "$REPO_DIR/.git" ]] || return 0
    command -v git &>/dev/null || return 0
    local cache="$HOME/.openmono/.update_check" now stamp=0
    now="$(date +%s)"
    [[ -f "$cache" ]] && stamp="$(sed -n '1p' "$cache" 2>/dev/null || echo 0)"
    [[ "$stamp" =~ ^[0-9]+$ ]] || stamp=0
    if [[ $(( now - stamp )) -gt 21600 ]]; then
        ( _refresh_update_cache ) >/dev/null 2>&1 &
    fi
    [[ -f "$cache" ]] && sed -n '2p' "$cache" 2>/dev/null || true
}

CLIPBOARD_BRIDGE_PID=""

_host_clip_cmd() {
    if command -v pbcopy &>/dev/null; then echo "pbcopy"; return 0; fi
    if command -v wl-copy &>/dev/null; then echo "wl-copy"; return 0; fi
    if command -v xclip &>/dev/null; then echo "xclip -selection clipboard"; return 0; fi
    if command -v xsel &>/dev/null; then echo "xsel --clipboard --input"; return 0; fi
    echo ""
}

_clipboard_bridge_start() {
    local clipcmd; clipcmd="$(_host_clip_cmd)"
    [[ -z "$clipcmd" ]] && return 0

    local cbfile="$HOME/.openmono/.clipboard-out"
    rm -f "$cbfile" 2>/dev/null || true

    (
        set +e
        last=""
        while :; do
            if [[ -s "$cbfile" ]]; then
                if command -v md5 &>/dev/null; then
                    h="$(md5 -q "$cbfile" 2>/dev/null)"
                elif command -v md5sum &>/dev/null; then
                    h="$(md5sum "$cbfile" 2>/dev/null | cut -d' ' -f1)"
                else
                    h="$(wc -c < "$cbfile" 2>/dev/null)"
                fi
                if [[ -n "$h" && "$h" != "$last" ]]; then
                    eval "$clipcmd" < "$cbfile" 2>/dev/null && last="$h"
                fi
            fi
            sleep 0.3
        done
    ) &
    CLIPBOARD_BRIDGE_PID=$!
}

_clipboard_bridge_stop() {
    [[ -n "${CLIPBOARD_BRIDGE_PID:-}" ]] && kill "$CLIPBOARD_BRIDGE_PID" 2>/dev/null
    CLIPBOARD_BRIDGE_PID=""
}

# ── Host sub-agent (bare-metal operator via ACP bridge) ────────────────────────
# `--host` runs the .NET host-bridge on bare metal. The bridge drives this box's
# in-container agent over ACP — the same HTTP/SSE API the VS Code extension and
# the smoke test use — and executes host commands itself (shell, git, files,
# installs). The model loop stays in the container: nothing here runs inference
# or duplicates the agent. VS Code / extension use (--acp-only) stays
# sandbox-only and is rejected with --host.

cmd_agent_host_bin() {
    if [[ -n "${OPENMONO_HOST_BRIDGE_BIN:-}" && -x "$OPENMONO_HOST_BRIDGE_BIN" ]]; then
        printf '%s' "$OPENMONO_HOST_BRIDGE_BIN"
        return 0
    fi
    if [[ -x "$HOME/.openmono/bin/host-bridge/host-bridge" ]] &&
       "$HOME/.openmono/bin/host-bridge/host-bridge" --version &>/dev/null; then
        printf '%s' "$HOME/.openmono/bin/host-bridge/host-bridge"
        return 0
    fi
    return 1
}

cmd_agent_host_project() {
    local proj="$REPO_DIR/src/OpenMono.HostBridge/OpenMono.HostBridge.csproj"
    [[ -f "$proj" ]] || return 1
    command -v dotnet &>/dev/null || return 1
    printf '%s' "$proj"
    return 0
}

# Host-bridge daemon: the bare-metal half of host mode. The sandbox agent
# pairs with it over host.docker.internal using the shared pair_secret from
# ~/.openmono/host-bridge.json; every host command the user approves runs on
# the host machine, audited + policy-gated. `openmono agent --host` starts it
# automatically; `openmono host daemon` starts it standalone (manual /host on).
HOST_DAEMON_PORT="${OPENMONO_HOST_DAEMON_PORT:-7476}"
HOST_DAEMON_PIDFILE="$HOME/.openmono/host-daemon.pid"
HOST_DAEMON_LOG="$HOME/.openmono/logs/host-daemon.log"

_host_daemon_container_url() {
    # Linux: containers reach the host at the docker bridge gateway; the request
    # lands on the socket bound to that bridge IP, so the URL must name it (the
    # daemon binds its bridge IPs too). host.docker.internal + a forced
    # Host: 127.0.0.1 header mismatches the bound prefix -> HttpListener 404.
    # macOS (Docker Desktop vpnkit) lands on host loopback, so keep the name.
    if [[ "$(uname -s)" == Linux ]]; then
        local gw
        gw="$(docker network inspect bridge -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null)"
        if [[ "$gw" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "http://${gw}:${HOST_DAEMON_PORT}"
            return
        fi
    fi
    echo "http://host.docker.internal:${HOST_DAEMON_PORT}"
}

_host_daemon_bin() {
    local bin proj
    if bin="$(cmd_agent_host_bin)"; then
        printf 'bin\t%s' "$bin"
        return 0
    fi
    if proj="$(cmd_agent_host_project)"; then
        printf 'proj\t%s' "$proj"
        return 0
    fi
    return 1
}

_host_daemon_alive() {
    curl -sf --max-time 2 "http://127.0.0.1:${HOST_DAEMON_PORT}/ping" &>/dev/null
}

_host_daemon_start() {
    _HOST_DAEMON_LAUNCHED=0
    _host_daemon_alive && return 0
    local spec kind target
    spec="$(_host_daemon_bin)" || {
        err "Host sub-agent is not installed."
        err "Install it with: bash $REPO_DIR/scripts/install-host-bridge.sh"
        return 1
    }
    kind="${spec%%$'\t'*}"
    target="${spec#*$'\t'}"
    mkdir -p "$HOME/.openmono/logs"
    # Pre-create the daemon's bg-log dir as the current user. If Docker
    # auto-created it first (it owns the tmpfs shadow mountpoint in
    # ~/.openmono as root), background/as_root execs fail closed; tell the
    # operator how to fix ownership instead of failing silently.
    if ! mkdir -p "$HOME/.openmono/host-bridge/logs" 2>/dev/null; then
        err "~/.openmono/host-bridge/logs is not writable (usually root-owned, created by Docker)."
        err "Fix ownership with:  sudo chown -R \"$USER\" ~/.openmono/host-bridge"
    elif [[ ! -w "$HOME/.openmono/host-bridge/logs" ]]; then
        err "~/.openmono/host-bridge/logs exists but is not writable."
        err "Fix ownership with:  sudo chown -R \"$USER\" ~/.openmono/host-bridge"
    fi
    info "Starting host-bridge daemon on 127.0.0.1:${HOST_DAEMON_PORT} (log: $HOST_DAEMON_LOG)"
    # The prereqs installer puts .NET under ~/.dotnet and wires it into rc
    # files; a non-interactive shell never sources those, and the published
    # apphost needs DOTNET_ROOT to find the runtime then.
    if [[ -z "${DOTNET_ROOT:-}" && -x "$HOME/.dotnet/dotnet" ]]; then
        export DOTNET_ROOT="$HOME/.dotnet"
    fi
    if [[ "$kind" == "bin" ]]; then
        nohup "$target" --daemon --daemon-port "$HOST_DAEMON_PORT" --workdir "$(pwd)" \
            >>"$HOST_DAEMON_LOG" 2>&1 &
    else
        nohup dotnet run --project "$target" -- --daemon --daemon-port "$HOST_DAEMON_PORT" --workdir "$(pwd)" \
            >>"$HOST_DAEMON_LOG" 2>&1 &
    fi
    echo $! > "$HOST_DAEMON_PIDFILE"
    _HOST_DAEMON_LAUNCHED=1
    for _ in $(seq 1 20); do
        _host_daemon_alive && return 0
        sleep 0.5
    done
    err "Host-bridge daemon did not become reachable on port $HOST_DAEMON_PORT."
    err "See $HOST_DAEMON_LOG for details."
    return 1
}

_host_daemon_pair_secret() {
    local settings="$HOME/.openmono/host-bridge.json"
    if [[ -f "$settings" ]] && command -v jq &>/dev/null; then
        jq -r '.pair_secret // empty' "$settings"
    fi
}

_host_daemon_stop_owned() {
    # Only stop daemons this invocation started (pidfile), never a pre-existing
    # daemon the user started deliberately with `openmono host daemon`.
    [[ "${_HOST_DAEMON_OWNED:-}" == "1" ]] || return 0
    _HOST_DAEMON_OWNED=0
    # Daemon session tokens live in memory: killing it silently invalidates the
    # pairing of every OTHER running sandbox (their agent then reads HOST:ON
    # against a dead token). If other agent containers are still up, leave the
    # shared daemon running; it idles harmlessly.
    if [[ "$(docker ps --filter 'label=com.docker.compose.service=agent' --filter status=running -q 2>/dev/null | wc -l | tr -d ' ')" != "0" ]]; then
        return 0
    fi
    if [[ -f "$HOST_DAEMON_PIDFILE" ]]; then
        local pid
        pid="$(cat "$HOST_DAEMON_PIDFILE" 2>/dev/null)" || true
        [[ -n "$pid" ]] && kill "$pid" &>/dev/null || true
        rm -f "$HOST_DAEMON_PIDFILE"
    fi
}

cmd_host() {
    local sub="${1:-status}"
    case "$sub" in
        daemon|start)
            shift 2>/dev/null || true
            _host_daemon_start || return 1
            ok "host-bridge daemon is running on 127.0.0.1:${HOST_DAEMON_PORT}"
            info "Pair secret: ~/.openmono/host-bridge.json (0600) · audit: ~/.openmono/logs/"
            info "In the sandbox agent, connect with: /host on (pairs silently — agents started while this daemon is up get an invite automatically)"
            info "Approval is only needed for agents started BEFORE this daemon: openmono host requests && openmono host approve <id>"
            info "Stop with: openmono host stop"
            ;;
        stop)
            if [[ -f "$HOST_DAEMON_PIDFILE" ]]; then
                local pid
                pid="$(cat "$HOST_DAEMON_PIDFILE" 2>/dev/null)" || true
                if [[ -n "$pid" ]] && kill "$pid" &>/dev/null; then
                    rm -f "$HOST_DAEMON_PIDFILE"
                    ok "host-bridge daemon stopped"
                else
                    rm -f "$HOST_DAEMON_PIDFILE"
                    err "pidfile exists but process $pid is not running (cleaned up)"
                fi
            elif _host_daemon_alive; then
                # Daemon was started outside the launcher (no pidfile): find it
                # by port. Safe to kill the listener only after /status proves
                # a real host-bridge daemon answers there (a squatter on the
                # port must never get killed by us).
                if curl -sf --max-time 2 "http://127.0.0.1:${HOST_DAEMON_PORT}/status" 2>/dev/null \
                    | jq -e '.daemon == true' &>/dev/null; then
                    local pid
                    pid="$(lsof -ti "tcp:${HOST_DAEMON_PORT}" -sTCP:LISTEN 2>/dev/null | head -1)" || true
                    if [[ -n "$pid" ]] && kill "$pid" &>/dev/null; then
                        sleep 1
                        ok "host-bridge daemon stopped (pid $pid — it had no pidfile, started outside the launcher)"
                    else
                        err "daemon confirmed on port $HOST_DAEMON_PORT but its process could not be killed — stop it manually (pkill -f host-bridge)"
                        return 1
                    fi
                else
                    err "something answers on port $HOST_DAEMON_PORT but it is not the host-bridge daemon — not killing anything"
                    return 1
                fi
            else
                info "no host-bridge daemon running"
            fi
            ;;
        status)
            local status_json
            status_json="$(curl -sf --max-time 2 "http://127.0.0.1:${HOST_DAEMON_PORT}/status" 2>/dev/null)" || status_json=""
            if [[ -n "$status_json" ]]; then
                ok "host-bridge daemon is up on 127.0.0.1:${HOST_DAEMON_PORT}"
                if command -v jq &>/dev/null; then
                    local ver paired
                    ver="$(jq -r '.version // "?"' <<<"$status_json" 2>/dev/null)"
                    paired="$(jq -r '.paired_sessions // 0' <<<"$status_json" 2>/dev/null)"
                    info "version ${ver} · paired sessions: ${paired}"
                else
                    head -c 200 <<<"$status_json"; echo ""
                fi
                if [[ "${2:-}" == "--show" ]]; then
                    if command -v jq &>/dev/null; then
                        info "pair secret: $(jq -r '.pair_secret // "(none)"' "$HOME/.openmono/host-bridge.json" 2>/dev/null)"
                    else
                        info "pair secret: (jq not installed — see ~/.openmono/host-bridge.json)"
                    fi
                fi
            elif _host_daemon_alive; then
                ok "host-bridge daemon is up on 127.0.0.1:${HOST_DAEMON_PORT} (no /status support - upgrade for details)"
            else
                info "host-bridge daemon is not running (start with: openmono host daemon)"
            fi
            ;;
        invite)
            # Mint a pairing invite for a manual sandbox launch (TTL-bounded):
            #   export OPENMONO_HOST_INVITE=$(openmono host invite)
            if ! _host_daemon_alive; then err "no daemon running on port $HOST_DAEMON_PORT"; return 1; fi
            local secret inv
            secret="$(_host_daemon_pair_secret)"
            [[ -z "$secret" ]] && { err "no pair_secret in ~/.openmono/host-bridge.json"; return 1; }
            inv="$(curl -sf --max-time 3 -X POST -d '' -H "X-Pair-Secret: $secret" \
                "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/invite" 2>/dev/null \
                | jq -r '.invite // empty' 2>/dev/null)"
            if [[ -z "$inv" ]]; then err "daemon did not issue an invite (old daemon version?)"; return 1; fi
            printf '%s\n' "$inv"
            info "TTL-bounded invite (every session in the run may pair with it) — launch with: OPENMONO_HOST_INVITE=<above> docker compose run ..."
            ;;
        approve|deny)
            local sid="${2:-}"
            if [[ -z "$sid" ]] || ! _host_daemon_alive; then
                [[ -z "$sid" ]] && err "Usage: openmono host $sub <session-id> (list with: openmono host requests)"
                _host_daemon_alive || err "no daemon running on port $HOST_DAEMON_PORT"
                return 1
            fi
            local secret body rc
            secret="$(_host_daemon_pair_secret)"
            [[ -z "$secret" ]] && { err "no pair_secret in ~/.openmono/host-bridge.json"; return 1; }
            body="{\"session_id\":\"$sid\"}"
            rc="$(curl -sf --max-time 3 -X POST -H "X-Pair-Secret: $secret" \
                -H "Content-Type: application/json" -d "$body" \
                "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/$sub" 2>/dev/null \
                | jq -r '.ok' 2>/dev/null)"
            if [[ "$rc" == "true" ]]; then
                ok "pair request $sub: $sid"
            else
                err "no pending pair request for '$sid' (or daemon error) — list with: openmono host requests"
                return 1
            fi
            ;;
        requests)
            if ! _host_daemon_alive; then info "no daemon running on port $HOST_DAEMON_PORT"; return 0; fi
            local secret reqs
            secret="$(_host_daemon_pair_secret)"
            [[ -z "$secret" ]] && { err "no pair_secret in ~/.openmono/host-bridge.json"; return 1; }
            reqs="$(curl -sf --max-time 3 -H "X-Pair-Secret: $secret" \
                "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/requests" 2>/dev/null)"
            if command -v jq &>/dev/null; then
                local n
                n="$(jq -r '.items | length' <<<"$reqs" 2>/dev/null)"
                if [[ "${n:-0}" == "0" ]]; then
                    info "no pending pair requests"
                else
                    jq -r '.items[] | "  session \(.session_id)\n    workdir \(.workdir)\n    approve: openmono host approve \(.session_id)"' <<<"$reqs"
                fi
            else
                head -c 300 <<<"$reqs"; echo ""
            fi
            ;;
        sessions|revoke)
            if ! _host_daemon_alive; then info "no daemon running on port $HOST_DAEMON_PORT"; return 0; fi
            local secret
            secret="$(_host_daemon_pair_secret)"
            [[ -z "$secret" ]] && { err "no pair_secret in ~/.openmono/host-bridge.json"; return 1; }
            if [[ "$sub" == "sessions" ]]; then
                local list
                list="$(curl -sf --max-time 3 -H "X-Pair-Secret: $secret" \
                    "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/sessions" 2>/dev/null)"
                if command -v jq &>/dev/null; then
                    local n
                    n="$(jq -r '.items | length' <<<"$list" 2>/dev/null)"
                    if [[ "${n:-0}" == "0" ]]; then
                        info "no paired sessions"
                    else
                        jq -r '.items[] | "  session \(.session_id) · since \(.since) · token \(.token_hint)*** · workdir \(.workdir)"' <<<"$list"
                        info "revoke with: openmono host revoke <session-id>"
                    fi
                else
                    head -c 300 <<<"$list"; echo ""
                fi
            else
                local sid="${2:-}"
                [[ -z "$sid" ]] && { err "Usage: openmono host revoke <session-id> (list with: openmono host sessions)"; return 1; }
                local r
                r="$(curl -sf --max-time 3 -X POST -H "X-Pair-Secret: $secret" \
                    -H "Content-Type: application/json" -d "{\"session_id\":\"$sid\"}" \
                    "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/revoke" 2>/dev/null \
                    | jq -r '.ok' 2>/dev/null)"
                if [[ "$r" == "true" ]]; then ok "revoked session $sid"; else err "no such session: $sid"; return 1; fi
            fi
            ;;
        *)
            err "Usage: openmono host [daemon|start|stop|status|invite|requests|approve|deny|sessions|revoke]"
            return 1
            ;;
    esac
}

cmd_agent_host() {
    # VS Code / extension integration is sandbox-only by design.
    local a
    for a in ${1+"$@"}; do
        if [[ "$a" == "--acp-only" ]]; then
            err "--acp-only (VS Code / Cursor extension mode) is only supported in sandbox mode."
            err "Run without --host: openmono agent --acp-only --acp-port 7475"
            exit 1
        fi
    done

    # Fail fast when no inference is configured (local or relay).
    local settings="$HOME/.openmono/settings.json"
    local cfg_endpoint=""
    if [[ -f "$settings" ]] && command -v jq &>/dev/null; then
        if ! jq -e . "$settings" >/dev/null 2>&1; then
            err "~/.openmono/settings.json is corrupt — cannot read llm.endpoint."
            err "Check for stray text after the closing brace (a stray character breaks the whole file),"
            err "or restore settings.json.bak, then re-run 'openmono config set llm.endpoint <url>'."
            exit 1
        fi
        cfg_endpoint=$(jq -r '.llm.endpoint // empty' "$settings")
    fi
    if [[ -z "$cfg_endpoint" ]]; then
        err "No LLM endpoint configured in ~/.openmono/settings.json"
        err "Point at local inference or your relay:"
        err "  openmono config set llm.endpoint http://localhost:7474      # local inference (Strata / llama.cpp)"
        err "  openmono config set llm.endpoint http://<relay-host>:<remotePort>"
        err "  openmono config set llm.api_key <token>"
        exit 1
    fi

    # Local inference still starts the familiar way; remote (relay/direct) needs nothing.
    local is_local=false
    case "$cfg_endpoint" in
        http://localhost:*|http://127.0.0.1:*)
            is_local=true
            ;;
    esac
    if [[ "$is_local" == "true" ]] && ! _inference_curl -sf --max-time 3 "${cfg_endpoint%/}/health" &>/dev/null; then
        if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
            info "Local inference is not responding — starting it now..."
            cmd_start || exit 1
        elif [[ "$NATIVE_INFERENCE" == "true" ]]; then
            info "Local inference is not responding — starting it now..."
            cmd_start || exit 1
        else
            err "Local inference endpoint $cfg_endpoint is not responding and Docker is unavailable."
            err "Start inference with: openmono start"
            err "Or point at your relay: openmono config set llm.endpoint http://<relay-host>:<remotePort>"
            exit 1
        fi
    fi

    export OPENMONO_REPO_DIR="$REPO_DIR"

    # New host mode: the model loop still runs in the sandbox (same safety,
    # same UI), while a host-bridge daemon runs on this machine. Pairing uses
    # the shared secret; every host action gets a HOST EXECUTION card first,
    # then runs audited + policy-gated on bare metal. The daemon is started
    # here and stopped when the agent exits (unless the user started their own).
    _host_daemon_start || exit 1
    if [[ "${_HOST_DAEMON_LAUNCHED:-0}" == "1" ]]; then
        _HOST_DAEMON_OWNED=1
        trap '_host_daemon_stop_owned' EXIT INT TERM
    fi

    local secret invite
    secret="$(_host_daemon_pair_secret)"
    if [[ -z "$secret" ]]; then
        err "No pair_secret in ~/.openmono/host-bridge.json — the daemon failed to generate one."
        err "Check $HOST_DAEMON_LOG"
        exit 1
    fi
    # Preferred path: a TTL-bounded invite (every session in the run may pair
    # with it). If the daemon is
    # too old to have /admin/invite, fall back to the shared secret.
    invite="$(curl -sf --max-time 3 -X POST -d '' \
        -H "X-Pair-Secret: $secret" \
        "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/invite" 2>/dev/null \
        | jq -r '.invite // empty' 2>/dev/null)"
    export OPENMONO_HOST_MODE=1
    export OPENMONO_HOST_DAEMON_URL="$(_host_daemon_container_url)"
    # The sandbox needs the HOST's OS, not the container's: the daemon-URL
    # rewrite (host.docker.internal -> bridge IPv4) is a Linux-host behavior,
    # and macOS routing (Docker Desktop vpnkit vs Colima vmnet) differs.
    export OPENMONO_HOST_OS="$(uname -s)"
    if [[ -n "$invite" ]]; then
        export OPENMONO_HOST_INVITE="$invite"
    else
        export OPENMONO_HOST_PAIR_SECRET="$secret"
    fi
    export OPENMONO_HOST_WORKSPACE="$(pwd)"

    cmd_agent_sandbox "$@"
    local rc=$?
    _host_daemon_stop_owned
    return $rc
}

cmd_agent() {
    local mode="${OPENMONO_AGENT_MODE:-sandbox}"
    local fwd=()
    local a
    for a in ${1+"$@"}; do
        case "$a" in
            --host) mode=host ;;
            --sandbox) mode=sandbox ;;
            *) fwd+=("$a") ;;
        esac
    done
    set -- "${fwd[@]+"${fwd[@]}"}"
    case "$mode" in
        host) cmd_agent_host "$@" ;;
        sandbox) cmd_agent_sandbox "$@" ;;
        *)
            err "Unknown agent mode: $mode (use --host, --sandbox, or OPENMONO_AGENT_MODE=host|sandbox)"
            exit 1
            ;;
    esac
}

cmd_agent_sandbox() {
    _ensure_docker
    WORKSPACE="${WORKSPACE:-$(pwd)}"
    export WORKSPACE

    mkdir -p "${HOME}/.openmono"
    # Defensive: keep host-bridge.json a file. The main compose shadows it with
    # /dev/null inside the sandbox, but any variant that bind-mounts the file
    # directly would have Docker create a DIRECTORY at that host path when the
    # source is missing — which then blocks the daemon from writing its config.
    # Empty file = daemon generates defaults + pair secret on first run.
    [[ -e "${HOME}/.openmono/host-bridge.json" ]] || : > "${HOME}/.openmono/host-bridge.json"

    cd "$DOCKER_DIR"

    local settings="$HOME/.openmono/settings.json"
    local cfg_endpoint cfg_key cfg_web_gateway cfg_web_search cfg_web_scrape
    if [[ -f "$settings" ]] && command -v jq &>/dev/null; then
        if ! jq -e . "$settings" >/dev/null 2>&1; then
            err "~/.openmono/settings.json is corrupt — cannot read llm.endpoint."
            err "Check for stray text after the closing brace (a stray character breaks the whole file),"
            err "or restore settings.json.bak, then re-run 'openmono config set llm.endpoint <url>'."
            exit 1
        fi
        cfg_endpoint=$(jq -r '.llm.endpoint // empty' "$settings")
        cfg_key=$(jq -r '.llm.api_key // empty' "$settings")
        [[ -n "$cfg_key" ]] && export OPENMONO_API_KEY="$cfg_key"
        cfg_web_gateway=$(jq -r '.web.gateway // empty' "$settings")
        cfg_web_search=$(jq -r '.web.search // empty' "$settings")
        cfg_web_scrape=$(jq -r '.web.scrape // empty' "$settings")
    fi

    if [[ -n "${cfg_web_gateway:-}" ]]; then
        case "$cfg_web_gateway" in
            http://localhost:* | http://127.0.0.1:* | http://host.docker.internal:*)
                export OPENMONO_WEB_GATEWAY="http://caddy:8080" ;;
            *)
                export OPENMONO_WEB_GATEWAY="$cfg_web_gateway" ;;
        esac
        [[ -n "${cfg_web_search:-}" ]] && export OPENMONO_WEB_SEARCH="$cfg_web_search"
        [[ -n "${cfg_web_scrape:-}" ]] && export OPENMONO_WEB_SCRAPE="$cfg_web_scrape"
    fi

    # An explicit OPENMONO_ENDPOINT wins over settings.json — the same precedence
    # the CLI's ConfigLoader uses — so it can be overridden per invocation.
    cfg_endpoint="${OPENMONO_ENDPOINT:-${cfg_endpoint:-}}"

    if [[ -z "$cfg_endpoint" ]]; then
        err "No LLM endpoint configured in ~/.openmono/settings.json"
        err "Configure your inference server:"
        err "  openmono config set llm.endpoint http://<server-ip>:<port>"
        exit 1
    fi

    local is_local=false
    case "$cfg_endpoint" in
        http://localhost:* | http://127.0.0.1:* | http://host.docker.internal:*)
            is_local=true
            ;;
    esac

    if [[ "$is_local" == "true" ]]; then
        if [[ "$NATIVE_INFERENCE" == "true" ]]; then
            source "$REPO_DIR/scripts/macos/inference.sh" 2>/dev/null || true
            native_load_config || exit 1
            native_ensure_running || exit 1
        elif [[ "$(_inference_backend)" == "strata" ]]; then
            # Strata backend: the first auto-start block above (via cmd_start →
            # scripts/strata.sh) already handled this. Nothing llama to do here.
            true
        else
            # Probe the port compose actually binds (resolved from docker/.env
            # above) — a hardcoded 7474 declares a running server dead when a
            # previous install moved the host mapping.
            local _hport="$INFERENCE_PORT"
            if _inference_curl -sf "http://localhost:${_hport}/health" &>/dev/null; then
                # If settings.json points at a different port than the live
                # server, the config is stale — say so instead of silently
                # waiting on the wrong door.
                local _ep _eport
                _ep="${cfg_endpoint#*://}"; _ep="${_ep%%/*}"
                _eport="${_ep##*:}"
                if [[ "$_eport" =~ ^[0-9]+$ && "$_eport" != "$_hport" ]]; then
                    warn "llama-server is healthy on port ${_hport} but llm.endpoint says :${_eport} — updating settings"
                    if command -v jq &>/dev/null && [[ -f "$settings" ]]; then
                        jq --arg e "http://127.0.0.1:${_hport}" '.llm.endpoint = $e' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
                        cfg_endpoint="http://127.0.0.1:${_hport}"
                    fi
                fi
            fi
            if ! _inference_curl -sf "http://localhost:${_hport}/health" &>/dev/null; then
                info "llama-server not responding on port ${_hport} — restarting..."
                docker compose up -d llama-server
                info "Waiting for llama-server to be healthy (model load can take 1-2 min)..."
                for i in $(seq 1 36); do
                    if _inference_curl -sf "http://localhost:${_hport}/health" &>/dev/null; then
                        ok "llama-server is healthy on port ${_hport}"
                        break
                    fi
                    sleep 5
                    printf "."
                done
                echo ""
            fi
        fi
    fi

     if [[ "$is_local" == "true" ]]; then
        # The configured endpoint points at loopback / the host gateway, which
        # the agent container cannot reach by that name. Rewrite the HOST only,
        # preserving the port and any base path from the config, so a custom
        # custom inference.port or an endpoint like ...:8081/v1 keeps working:
        #   - Strata serves host-native → reach it via the host gateway.
        #   - Native Metal llama.cpp also runs on the HOST (not in compose) →
        #     same host-gateway rewrite; leaving localhost in place makes the
        #     container dial itself and every chat request connection-refuses.
        #   - llama.cpp runs in its own container → reach it by service name.
        local _ep _host_port _port _path
        _ep="${cfg_endpoint#*://}"          # host[:port][/path]
        _host_port="${_ep%%/*}"
        _path=""
        [[ "$_ep" == */* ]] && _path="/${_ep#*/}"
        _port="${_host_port##*:}"
        [[ "$_port" == "$_host_port" ]] && _port=""   # no explicit port
        if [[ "$(_inference_backend)" == "strata" ]]; then
            _port="${_port:-$(_strata_port)}"
            export OPENMONO_ENDPOINT="http://host.docker.internal:${_port}${_path}"
        elif [[ "$NATIVE_INFERENCE" == "true" ]]; then
            # Apple-Silicon native Metal: llama-server is a host process bound
            # to the host's loopback/port. The sandbox reaches host loopback via
            # the docker desktop / colima host gateway under the same port.
            _port="${_port:-7474}"
            export OPENMONO_ENDPOINT="http://host.docker.internal:${_port}${_path}"
        else
            _port="${_port:-7474}"
            # llama.cpp listens on 7474 INSIDE the container regardless of the
            # host mapping (compose maps INFERENCE_PORT->7474). If the endpoint
            # names the host-side port, translate it to the internal one.
            if [[ "$_port" == "$INFERENCE_PORT" && "$INFERENCE_PORT" != "7474" ]]; then
                _port=7474
            fi
            export OPENMONO_ENDPOINT="http://llama-server:${_port}${_path}"
        fi
    else
        export OPENMONO_ENDPOINT="$cfg_endpoint"
    fi

    local git_args=()
    if [[ "${OPENMONO_NO_GIT_AUTH:-0}" != "1" ]]; then
 
        [[ -f "$HOME/.gitconfig" ]] && git_args+=(-v "$HOME/.gitconfig:/home/agent/.gitconfig:ro")
 
        [[ -d "$HOME/.ssh" ]] && git_args+=(-v "$HOME/.ssh:/home/agent/.ssh:ro")
 
        [[ -f "$HOME/.git-credentials" ]] && git_args+=(-v "$HOME/.git-credentials:/home/agent/.git-credentials:ro")
        if [[ "$_OPENMONO_OS" == "Darwin" && -d "/Applications/Docker.app" ]]; then
            git_args+=(-v "/run/host-services/ssh-auth.sock:/ssh-agent" -e "SSH_AUTH_SOCK=/ssh-agent")
        elif [[ "$_OPENMONO_OS" != "Darwin" && -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
            git_args+=(-v "${SSH_AUTH_SOCK}:/ssh-agent" -e "SSH_AUTH_SOCK=/ssh-agent")
        fi

        git_args+=(-e "GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes")
 
        git_args+=(-e "GIT_TERMINAL_PROMPT=0")
 
        git_args+=(-e "GIT_CONFIG_COUNT=1" -e "GIT_CONFIG_KEY_0=safe.directory" -e "GIT_CONFIG_VALUE_0=/workspace")
    fi


    # Docker socket is opt-in only: the default sandbox must NOT get the host
    # daemon. Set OPENMONO_DOCKER_SOCK=1 when the task actually needs docker
    # against the host (deploy + troubleshoot containerized backends).
    # OPENMONO_NO_DOCKER_SOCK=1 remains supported as an explicit veto (and as
    # a harmless no-op for existing configs that set it).
    local docker_sock_args=()
    if [[ "${OPENMONO_DOCKER_SOCK:-0}" == "1" && "${OPENMONO_NO_DOCKER_SOCK:-0}" != "1" && -S /var/run/docker.sock ]]; then
        docker_sock_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
    fi

    local extra_env=()
    local _upd; _upd="$(_update_notice 2>/dev/null || true)"
    [[ -n "$_upd" ]] && extra_env+=(-e "OPENMONO_UPDATE_NOTICE=$_upd")

    # Host mode: forward the daemon pairing details injected by cmd_agent_host
    # into the sandbox so the agent pairs on boot (HOST:ON + standing orders).
    if [[ "${OPENMONO_HOST_MODE:-}" == "1" ]]; then
        extra_env+=(
            -e "OPENMONO_HOST_MODE=1"
            -e "OPENMONO_HOST_DAEMON_URL=${OPENMONO_HOST_DAEMON_URL:-}"
            -e "OPENMONO_HOST_OS=${OPENMONO_HOST_OS:-}"
            -e "OPENMONO_HOST_WORKSPACE=${OPENMONO_HOST_WORKSPACE:-$WORKSPACE}")
        # The invite (TTL-bounded) is preferred; the pair secret never enters the
        # sandbox when the daemon supports /admin/invite.
        if [[ -n "${OPENMONO_HOST_INVITE:-}" ]]; then
            extra_env+=(-e "OPENMONO_HOST_INVITE=${OPENMONO_HOST_INVITE}")
        elif [[ -n "${OPENMONO_HOST_PAIR_SECRET:-}" ]]; then
            extra_env+=(-e "OPENMONO_HOST_PAIR_SECRET=${OPENMONO_HOST_PAIR_SECRET}")
        fi
    elif [[ "${OPENMONO_HOST_AUTO_INVITE:-1}" == "1" ]] \
        && curl -sf --max-time 2 "http://127.0.0.1:${HOST_DAEMON_PORT}/ping" &>/dev/null; then
        # Plain `openmono agent` with a daemon already running: mint a
        # long-TTL invite (host-side, pair secret never leaves) and
        # inject it WITHOUT OPENMONO_HOST_MODE. Nothing pairs on boot — the
        # invite is consumed only when the user runs /host on or clicks the
        # extension button, which then pairs silently (no approve step).
        # Opt out: OPENMONO_HOST_AUTO_INVITE=0 (keeps the approval lane).
        # Trade-off, by design: the invite sits in the container env until
        # used, so sandbox code could consume it; the daemon's deny-list,
        # sudo=ask and command audit still apply.
        local _auto_secret _auto_invite
        _auto_secret="$(_host_daemon_pair_secret)"
        if [[ -n "$_auto_secret" ]]; then
            _auto_invite="$(curl -sf --max-time 3 -X POST \
                -H "X-Pair-Secret: $_auto_secret" \
                -H "content-type: application/json" \
                -d '{"ttl_seconds":43200}' \
                "http://127.0.0.1:${HOST_DAEMON_PORT}/admin/invite" 2>/dev/null \
                | jq -r '.invite // empty' 2>/dev/null)"
            if [[ -n "$_auto_invite" ]]; then
                extra_env+=(
                    -e "OPENMONO_HOST_INVITE=${_auto_invite}"
                    -e "OPENMONO_HOST_DAEMON_URL=$(_host_daemon_container_url)"
                    -e "OPENMONO_HOST_WORKSPACE=${OPENMONO_HOST_WORKSPACE:-$WORKSPACE}")
            fi
        fi
    fi

    _clipboard_bridge_start
    trap '_clipboard_bridge_stop' EXIT INT TERM

    local _agent_rc=0
    docker compose run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/home/agent \
        -e WORKSPACE="$WORKSPACE" \
        "${git_args[@]+"${git_args[@]}"}" \
        "${docker_sock_args[@]+"${docker_sock_args[@]}"}" \
        "${extra_env[@]+"${extra_env[@]}"}" \
        agent "$@" || _agent_rc=$?

    _clipboard_bridge_stop
    trap - EXIT INT TERM
    return $_agent_rc
}

