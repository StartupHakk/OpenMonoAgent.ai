#!/usr/bin/env bash
set -eo pipefail

# ──────────────────────────────────────────────────────────────────────────────
# openmono — OpenMono.ai CLI
# Usage: openmono <command>
# ──────────────────────────────────────────────────────────────────────────────

# Resolve to real script location, handling symlinks
# Try $0 first (most reliable), fall back to BASH_SOURCE
OPENMONO_SCRIPT="${0}"
if [[ ! -f "$OPENMONO_SCRIPT" ]]; then
    OPENMONO_SCRIPT="${BASH_SOURCE[0]}"
fi
# Make it absolute if relative
if [[ "$OPENMONO_SCRIPT" != /* ]]; then
    OPENMONO_SCRIPT="$(cd "$(dirname "$OPENMONO_SCRIPT")" && pwd)/$(basename "$OPENMONO_SCRIPT")"
fi
# Follow symlinks to real location
while [[ -L "$OPENMONO_SCRIPT" ]]; do
    OPENMONO_SCRIPT="$(readlink -f "$OPENMONO_SCRIPT" 2>/dev/null || readlink "$OPENMONO_SCRIPT")"
done
REPO_DIR="$(cd "$(dirname "$OPENMONO_SCRIPT")" && pwd)"
DOCKER_DIR="$REPO_DIR/docker"
INFERENCE_PORT="${INFERENCE_PORT:-7474}"
OPENMONO_VERSION="$(cat "$REPO_DIR/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")"

# The prereqs installer keeps the patched .NET under ~/.dotnet and wires it
# into login shells only. IDE extensions, cron and non-interactive `openmono`
# runs never source those rc files — the published host-bridge apphost needs
# DOTNET_ROOT to find a runtime at all, and it must be the patched one. Pick
# the newest of ~/.dotnet and PATH here so every host path uses it.
# shellcheck source=scripts/lib/dotnet.sh
source "$REPO_DIR/scripts/lib/dotnet.sh"
dotnet_activate_best || true

# Version-pin resolution (repo versions.json + ~/.openmono/versions.json locks).
# shellcheck source=scripts/lib/versions.sh
source "$REPO_DIR/scripts/lib/versions.sh"

# On macOS Apple Silicon, llama-server runs natively via Homebrew (Metal GPU).
# It is never started/stopped via Docker on this platform.
_OPENMONO_OS=$(uname -s)
_OPENMONO_ARCH=$(uname -m)
# Derived default: true only on Apple Silicon Macs.
_OPENMONO_NATIVE_DEFAULT=false
[[ "$_OPENMONO_OS" == "Darwin" && "$_OPENMONO_ARCH" == "arm64" ]] && _OPENMONO_NATIVE_DEFAULT=true
# NATIVE_INFERENCE: whether llama runs natively (no docker/.env rewrite, frpc
# managed via Homebrew). OPENMONO_NATIVE overrides for tests.
NATIVE_INFERENCE="${OPENMONO_NATIVE:-$_OPENMONO_NATIVE_DEFAULT}"
# _OM_NATIVE_FRP: whether frpc is installed/managed via Homebrew (true on
# Apple Silicon by default; can be forced true on other platforms so the
# native frpc path is testable without disabling docker component reconcile).
_OM_NATIVE_FRP="${OPENMONO_NATIVE_FRP:-$_OPENMONO_NATIVE_DEFAULT}"

# Source macOS native helpers for macOS Apple Silicon
if [[ "$NATIVE_INFERENCE" == "true" ]]; then
    source "$REPO_DIR/scripts/macos/inference.sh"
    source "$REPO_DIR/scripts/macos/tunnel.sh"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[38;2;163;255;102m' # Neon Green (replaces primary blue)
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ── Docker accessibility check ─────────────────────────────────────────────────

_ensure_docker() {
    if docker info &>/dev/null 2>&1; then
        return 0
    fi

    _OS=$(uname -s)
    warn "Docker daemon is not accessible. Attempting to start..."

    if [ "$_OS" = "Darwin" ]; then
        # Try Docker Desktop first (if installed)
        if [ -d "/Applications/Docker.app" ]; then
            info "Starting Docker Desktop..."
            open /Applications/Docker.app
            info "Waiting for Docker daemon (up to 60s)..."
            for i in $(seq 1 60); do
                if docker info &>/dev/null 2>&1; then
                    ok "Docker is ready"
                    return 0
                fi
                sleep 1
                printf "."
            done
            echo ""
            err "Docker Desktop started but daemon is not accessible. Try: colima status"
        # Fallback to Colima if Docker Desktop is not installed
        elif command -v colima &>/dev/null; then
            info "Starting Colima..."
            if colima start 2>/dev/null; then
                for i in $(seq 1 15); do
                    docker info &>/dev/null 2>&1 && { ok "Docker is ready"; return 0; }
                    sleep 1
                done
            fi
            err "Colima failed to start. Try: colima status"
        else
            err "Neither Docker Desktop nor Colima is available. Try: openmono setup"
        fi
    else
        info "Starting Docker daemon..."
        if sudo systemctl start docker 2>/dev/null; then
            for i in $(seq 1 15); do
                docker info &>/dev/null 2>&1 && { ok "Docker is ready"; return 0; }
                sleep 1
            done
            err "Docker started but daemon is not accessible"
        else
            err "Failed to start Docker. Try: sudo systemctl start docker"
        fi
    fi

    exit 1
}

# ── docker/.env helpers (server-side service registry) ──────────────────────────

_env_get() {
    local key="$1" env_file="$DOCKER_DIR/.env"
    [[ -f "$env_file" ]] || return 0
    local line
    line="$(grep "^${key}=" "$env_file" 2>/dev/null | head -1 || true)"
    if [[ -n "$line" ]]; then printf '%s' "${line#*=}"; fi
    return 0
}

# Resolve the applied bind port once docker/.env helpers exist. INFERENCE_PORT is
# the single applied key; LLAMA_PORT/STRATA_PORT are only read from old installs.
INFERENCE_PORT="${INFERENCE_PORT:-$(_env_get INFERENCE_PORT)}"
[[ -n "$INFERENCE_PORT" ]] || INFERENCE_PORT="$(_env_get LLAMA_PORT)"
[[ -n "$INFERENCE_PORT" ]] || INFERENCE_PORT="$(_env_get STRATA_PORT)"
INFERENCE_PORT="${INFERENCE_PORT:-7474}"

# curl the local inference server with the shared bearer key. llama.cpp serves
# /health and /v1/health without one, but /props and /v1/models are gated, and
# Strata gates more than llama.cpp — so send the key on every call.
_inference_curl() {
    local key
    key="$(_env_get LLAMA_API_KEY)"
    if [[ -n "$key" ]]; then
        curl -H "Authorization: Bearer $key" "$@"
    else
        curl "$@"
    fi
}

_env_set() {
    local key="$1" val="$2" env_file="$DOCKER_DIR/.env"
    mkdir -p "$(dirname "$env_file")"; touch "$env_file"
    local tmp="$env_file.tmp"
    grep -v "^${key}=" "$env_file" > "$tmp" 2>/dev/null || true
    printf '%s=%s\n' "$key" "$val" >> "$tmp"
    mv "$tmp" "$env_file"
    chmod 0600 "$env_file"
}

# Mirror the LLAMA_API_KEY into ~/.openmono/settings.json (llm.api_key) so the
# local agent's config never drifts from the backend's live key: docker/.env is
# what llama-server/gateway start with, settings.json is what the agent dials
# with. Only touches an existing settings file (a missing one means setup has
# not run yet — the setup flow writes the key itself).
_sync_api_key_to_settings() {
    local key="$1"
    local settings="$HOME/.openmono/settings.json"
    [[ -n "$key" && -f "$settings" ]] || return 0
    command -v jq &>/dev/null || return 0
    cmd_config set llm.api_key "$key" >/dev/null 2>&1 || true
}

# ── Settings -> applied inference state ──────────────────────────────────────
# settings.json is desired state; scripts/apply_settings.sh writes the shared
# runtime knobs (port, parallel slots, API key, Caddy upstream) into the files
# the backends actually read. These helpers wire that into start/stop/restart.
APPLY_SETTINGS="$REPO_DIR/scripts/apply_settings.sh"

_settings_file() { printf '%s' "$HOME/.openmono/settings.json"; }

_refresh_inference_env() {
    INFERENCE_PORT="$(_env_get INFERENCE_PORT)"
    [[ -n "$INFERENCE_PORT" ]] || INFERENCE_PORT="$(_env_get LLAMA_PORT)"
    [[ -n "$INFERENCE_PORT" ]] || INFERENCE_PORT="$(_env_get STRATA_PORT)"
    INFERENCE_PORT="${INFERENCE_PORT:-7474}"
}

_apply_inference_settings() {
    [[ -f "$APPLY_SETTINGS" ]] || return 0
    bash "$APPLY_SETTINGS" --apply --quiet || warn "Could not apply inference settings."
    _refresh_inference_env
}

# 0 = in sync, 2 = drift, 1/other = could not check.
_inference_settings_drift() {
    [[ -f "$APPLY_SETTINGS" ]] || return 0
    bash "$APPLY_SETTINGS" --check --quiet >/dev/null 2>&1
    return $?
}

# The port currently written to the applied state (old value, before apply).
_applied_inference_port() {
    local p
    p="$(_env_get INFERENCE_PORT)"
    [[ -n "$p" ]] || p="$(_env_get LLAMA_PORT)"
    [[ -n "$p" ]] || p="$(_env_get STRATA_PORT)"
    printf '%s' "${p:-7474}"
}

# Whether this box runs inference locally (vs agent-only pointing at a relay).
_has_local_inference() {
    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        command -v jq &>/dev/null && [[ -f "$(_settings_file)" ]] && \
            jq -e '.inference.model_name // empty' "$(_settings_file)" >/dev/null 2>&1
        return
    fi
    [[ -f "$HOME/.openmono/strata.env" ]] && return 0
    [[ -n "$(_env_get INFERENCE_BACKEND)" ]] && return 0
    [[ -n "$(_env_get MODEL_NAME)" ]] && return 0
    [[ -n "$(_env_get INFERENCE_PORT)" ]] && return 0
    [[ -n "$(_env_get LLAMA_PORT)" ]] && return 0
    [[ -n "$(_env_get STRATA_PORT)" ]] && return 0
    return 1
}

# Stop whatever backend is currently running, using applied state — not the
# possibly-edited settings.json — so a changed port still stops the old server.
_stop_inference_backend_applied() {
    local applied
    applied="$(_applied_inference_port)"
    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        if command -v native_cmd_stop &>/dev/null; then
            OPENMONO_APPLIED_PORT="$applied" native_cmd_stop || true
        fi
    elif [[ "$(_inference_backend)" == "strata" ]]; then
        bash "$REPO_DIR/scripts/strata.sh" stop || true
    else
        if docker info &>/dev/null 2>&1; then
            (cd "$DOCKER_DIR" && docker compose stop llama-server) || true
        fi
    fi
}

# ── Inference backend selection (Linux) ─────────────────────────────────────
# Strata (Qwen3.8-Flash-Next, host-native :7474/v1) is the default for fresh
# installs on this branch; pre-existing installs without the marker keep the
# legacy llama.cpp Docker path. macOS Apple Silicon always uses NATIVE_INFERENCE.
_inference_backend() {
    local b
    b="$(_env_get INFERENCE_BACKEND)"
    if [[ "$b" == "strata" || "$b" == "llama" ]]; then
        printf '%s' "$b"
    elif [[ -f "$HOME/.openmono/strata.env" ]]; then
        printf 'strata'
    else
        printf 'llama'
    fi
}

# Port resolution: settings.json wins, then applied env, then 7474.
_inference_port() {
    local p=""
    if command -v jq &>/dev/null && [[ -f "$(_settings_file)" ]]; then
        p="$(jq -r '.inference.port // empty' "$(_settings_file)" 2>/dev/null || true)"
    fi
    if [[ ! "$p" =~ ^[0-9]+$ ]]; then
        p="$(_env_get INFERENCE_PORT)"
        [[ -n "$p" ]] || p="$(_env_get LLAMA_PORT)"
        [[ -n "$p" ]] || p="$(_env_get STRATA_PORT)"
    fi
    printf '%s' "${p:-7474}"
}

# Kept as a named alias for call sites that talk to Strata; there is one port.
_strata_port() { _inference_port; }

# Reuse the existing LLAMA_API_KEY as the gateway's shared bearer; generate one
# if absent. Sets _LLAMA_KEY_GENERATED so callers can restart the inference
# backend to apply it.
_ensure_llama_key() {
    local key; key="$(_env_get LLAMA_API_KEY)"
    if [[ -z "$key" ]]; then
        key="$(openssl rand -hex 24)"
        _env_set LLAMA_API_KEY "$key"
        _sync_api_key_to_settings "$key"
        _LLAMA_KEY_GENERATED=1
        info "Generated LLAMA_API_KEY (shared gateway bearer)" >&2
    fi
    printf '%s' "$key"
}

_apply_llama_key_restart() {
    [[ "${_LLAMA_KEY_GENERATED:-0}" == "1" ]] || return 0
    info "Restarting inference backend to apply the new API key..."
    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        command -v native_cmd_restart &>/dev/null && OPENMONO_APPLIED_PORT="$(_applied_inference_port)" native_cmd_restart || \
            warn "Restart inference backend manually: openmono restart"
    elif [[ "$(_inference_backend)" == "strata" ]]; then
        # Strata enforces its own --api-key, so restart it with the same key
        # the gateway/agent use; then recreate Caddy to pick up the env.
        _apply_inference_settings
        if [[ -f "$HOME/.openmono/strata.env" ]]; then
            bash "$REPO_DIR/scripts/strata.sh" stop || true
            bash "$REPO_DIR/scripts/strata.sh" start || \
                warn "Restart Strata manually: openmono restart"
        fi
        if (cd "$DOCKER_DIR" && _compose ps --services 2>/dev/null | grep -q '^caddy$'); then
            (cd "$DOCKER_DIR" && _compose up -d caddy) || \
                warn "Restart gateway manually: openmono restart"
        fi
    else
        _apply_inference_settings
        if (cd "$DOCKER_DIR" && docker compose ps --services 2>/dev/null | grep -q '^llama-server$'); then
            (cd "$DOCKER_DIR" && docker compose up -d --force-recreate llama-server) || \
                warn "Restart manually: cd $DOCKER_DIR && docker compose up -d --force-recreate llama-server"
        fi
    fi
}

# docker compose wrapper: on the Strata backend, layer
# docker-compose.strata.yml so the Caddy gateway fronts the host's Strata
# (host.docker.internal:7474) instead of the llama-server container.
_compose() {
    if [[ "$(_inference_backend)" == "strata" && -f "$DOCKER_DIR/docker-compose.strata.yml" ]]; then
        docker compose -f docker-compose.yml -f docker-compose.strata.yml "$@"
    else
        docker compose "$@"
    fi
}

# Bring up the gateway + whichever web services are installed (used by cmd_start
# and after 'openmono stop', which tears the whole stack down). Caddy is named
# explicitly so the inference backend container (llama-server, also in the
# server profile) isn't touched here. On the Strata backend the gateway is
# layered with docker-compose.strata.yml so it fronts the host's Strata.
_start_web_services() {
    [[ "$(_env_get GATEWAY_ENABLED)" == "true" ]] || return 0
    _ensure_docker
    local profiles=(--profile server) names=(caddy)
    [[ "$(_env_get WEB_SEARCH_ENABLED)" == "true" ]] && { profiles+=(--profile search); names+=(searxng); }
    [[ "$(_env_get WEB_SCRAPE_ENABLED)" == "true" ]] && { profiles+=(--profile scraper); names+=(scrapling); }
    info "Starting gateway (${names[*]})..."
    (cd "$DOCKER_DIR" && _compose "${profiles[@]}" up -d "${names[@]}") || \
        warn "Failed to start gateway services. Check: docker compose ps"
}

# Install/refresh the Caddy gateway baseline — the single front door the frpc
# tunnel routes through, whether or not SearXNG/Scrapling are added.
_setup_gateway() {
    _ensure_docker
    info "Setting up the Caddy gateway..."
    _ensure_llama_key >/dev/null
    _apply_inference_settings
    _env_set GATEWAY_ENABLED true
    (cd "$DOCKER_DIR" && _compose --profile server up -d caddy) || {
        err "Failed to start the gateway. Check: docker compose ps"; return 1
    }
    _apply_llama_key_restart
    local gw_port; gw_port="$(_env_get GATEWAY_PORT)"; gw_port="${gw_port:-7480}"
    _retarget_tunnel_to_gateway "$gw_port"
    _sync_agent_web_config "$gw_port"
    ok "Caddy gateway running on port ${gw_port}"
}

# Mirror the server-side registry (WEB_*_ENABLED) into the local agent config so
# a tool whose service isn't installed skips the gateway entirely (no wasted
# request) rather than trying and falling back. Idempotent; safe to re-run.
_sync_agent_web_config() {
    local gw_port="$1"
    cmd_config set web.gateway "http://host.docker.internal:${gw_port}" >/dev/null
    if [[ "$(_env_get WEB_SEARCH_ENABLED)" == "true" ]]; then
        cmd_config set web.search true >/dev/null
    else
        cmd_config set web.search false >/dev/null
    fi
    if [[ "$(_env_get WEB_SCRAPE_ENABLED)" == "true" ]]; then
        cmd_config set web.scrape true >/dev/null
    else
        cmd_config set web.scrape false >/dev/null
    fi
    local key; key="$(_env_get LLAMA_API_KEY)"
    [[ -n "$key" ]] && cmd_config set llm.api_key "$key" >/dev/null
}

# If an frpc tunnel already exists, re-point it at the gateway so the single
# remote port now reaches llama + web services. No-op when no tunnel is set up
# (fresh installs configure the gateway target directly in tunnel setup).
_retarget_tunnel_to_gateway() {
    local gw_port="$1" changed=false cfg brew_etc
    brew_etc="$(brew --prefix 2>/dev/null)/etc/frp/frpc.toml"
    for cfg in "$HOME/.config/frp/frpc.toml" "$brew_etc" "/etc/frp/frpc.toml"; do
        [[ -f "$cfg" ]] || continue
        grep -q '^localPort' "$cfg" || continue
        grep -q "^localPort[[:space:]]*=[[:space:]]*${gw_port}\b" "$cfg" && continue
        sed -i.bak -E "s/^(localPort[[:space:]]*=[[:space:]]*).*/\1${gw_port}/" "$cfg" 2>/dev/null && rm -f "$cfg.bak" || continue
        changed=true
        info "Re-pointed frpc tunnel ($cfg) at the gateway port ${gw_port}"
    done
    [[ "$changed" == "true" ]] || return 0
    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        brew services restart frpc >/dev/null 2>&1 && info "Restarted frpc" || \
            warn "Restart the tunnel to apply: openmono tunnel restart"
    else
        sudo systemctl restart frpc >/dev/null 2>&1 && info "Restarted frpc" || \
            warn "Restart the tunnel to apply: openmono tunnel restart"
    fi
}

# ── Optional web services (opt-in, run entirely in Docker) ──────────────────────

cmd_setup_search() {
    _ensure_docker
    info "Installing SearXNG (private web search)..."
    local key; key="$(_ensure_llama_key)"
    [[ -z "$(_env_get SEARXNG_SECRET)" ]] && _env_set SEARXNG_SECRET "$(openssl rand -hex 32)"
    _apply_inference_settings
    _env_set WEB_SEARCH_ENABLED true

    info "Starting SearXNG + gateway..."
    (cd "$DOCKER_DIR" && _compose --profile search up -d searxng caddy) || {
        err "Failed to start SearXNG. Check: docker compose ps"; return 1
    }
    _apply_llama_key_restart

    # Point a local (full-mode) agent at the gateway; reuse the shared key.
    local gw_port; gw_port="$(_env_get GATEWAY_PORT)"; gw_port="${gw_port:-7480}"
    _retarget_tunnel_to_gateway "$gw_port"
    _sync_agent_web_config "$gw_port"

    ok "SearXNG installed — WebSearch now routes through the gateway"
}

cmd_setup_scraper() {
    _ensure_docker
    info "Installing Scrapling (web scraper). First build downloads a browser — this can take a few minutes."
    local key; key="$(_ensure_llama_key)"
    _apply_inference_settings
    _env_set WEB_SCRAPE_ENABLED true

    (cd "$DOCKER_DIR" && docker compose --profile scraper build scrapling) || {
        err "Failed to build the Scrapling image."; return 1
    }
    info "Starting Scrapling + gateway..."
    (cd "$DOCKER_DIR" && _compose --profile scraper up -d scrapling caddy) || {
        err "Failed to start Scrapling. Check: docker compose ps"; return 1
    }
    _apply_llama_key_restart

    local gw_port; gw_port="$(_env_get GATEWAY_PORT)"; gw_port="${gw_port:-7480}"
    _retarget_tunnel_to_gateway "$gw_port"
    _sync_agent_web_config "$gw_port"

    ok "Scrapling installed — WebFetch now routes through the gateway"
}

# Offered at the end of a fresh full/inference install. Skipped when stdin is
# not a TTY (e.g. piped installers) — the one-liners are printed instead.
prompt_optional_services() {
    # Web services (SearXNG/Scrapling) live on the inference box only. An
    # agent-only box consumes them remotely through the relay, so never offer to
    # install them here — it auto-detects what the inference box exposes.
    case "${OPENMONO_ROLE:-}" in
        full|inference) ;;
        *) return 0 ;;
    esac

    # Inference (server) box: Caddy is the single front door the frpc tunnel
    # routes through, so install it regardless of which web services are added.
    if [[ "${OPENMONO_ROLE:-}" == "inference" ]]; then
        _setup_gateway || warn "Gateway setup hit an issue; retry: openmono setup gateway"
    fi

    echo ""
    echo -e "${BLUE}── Optional web services (private, run in Docker) ───────────${NC}"
    if [[ ! -t 0 ]]; then
        echo "  Add them any time with:"
        echo -e "    ${BOLD}openmono setup search${NC}    # private web search (SearXNG)"
        echo -e "    ${BOLD}openmono setup scraper${NC}   # anti-bot web scraping (Scrapling)"
        return 0
    fi
    # Guard each install so a hiccup in one doesn't abort the rest under 'set -e'.
    local ans
    printf "  Install private web search (SearXNG)? [y/N] "; read -r ans || true
    [[ "$ans" =~ ^[Yy] ]] && { cmd_setup_search || warn "SearXNG setup failed; retry: openmono setup search"; }
    printf "  Install web scraper (Scrapling, downloads a browser)? [y/N] "; read -r ans || true
    [[ "$ans" =~ ^[Yy] ]] && { cmd_setup_scraper || warn "Scrapling setup failed; retry: openmono setup scraper"; }
    echo ""
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_version() {
    echo "openmono $OPENMONO_VERSION"
}

cmd_help() {
    echo ""
    echo -e "${BLUE}╔══════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║        OpenMono.ai — AI Agent        ║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════╝${NC}"
    echo -e "  version $OPENMONO_VERSION"
    echo ""
    echo "Usage: openmono [--verbose|-v] <command>"
    echo ""
    echo "Commands are grouped by which box they run on. In single-box mode (default)"
    echo "everything runs on one machine; in dual-box mode you split them across"
    echo "an agent box and an inference box."
    echo ""
    echo "Any box:"
    printf "  %-14s %s\n" "setup"   "Install (--full|--inference|--agent) [--gpu|--cpu] [--model=bonsai-pq2|bonsai-ptq1|qwen]"
    printf "  %-14s %s\n" "upgrade" "Update to the latest version + rebuild the agent (--check to preview)"
    printf "  %-14s %s\n" "uninstall" "Remove OpenMono (--dry-run to preview; --deep also removes system packages)"
    printf "  %-14s %s\n" "config"  "Read/write ~/.openmono/settings.json (e.g. llm.endpoint, llm.api_key)"
    printf "  %-14s %s\n" "host"    "Host-bridge daemon for whole-machine mode [daemon|stop|status]"
    printf "  %-14s %s\n" "version" "Print the CLI version"
    printf "  %-14s %s\n" "help"    "Show this help"
    echo ""
    echo "Agent box (run the coding agent):"
    printf "  %-14s %s\n" "agent"    "Run the coding agent in the current directory [--host|--sandbox]"
    printf "  %-14s %s\n" "graph"    "Build the code-review-graph for a project"
    printf "  %-14s %s\n" "graphify" "Build the graphify knowledge graph for a project"
    echo ""
    echo "Agent modes (pick one per run; default: sandbox):"
    echo "  --sandbox  Container sandbox: project bind-mounted as /workspace."
    echo "             Required for the VS Code / Cursor extension (--acp-only)."
    echo "  --host     Whole-machine mode: starts the host-bridge daemon on"
    echo "             this box, then runs the agent sandboxed as usual. The"
    echo "             agent pairs with the daemon; every host command shows"
    echo "             a HOST EXECUTION card first, then runs audited on bare"
    echo "             metal (pull, build, install, redeploy, troubleshoot)."
    echo "             Policy: ~/.openmono/host-bridge.json"
    echo ""
    echo "Inference box (inference backend lifecycle):"
    printf "  %-14s %s\n" "start"   "Start inference backend + gateway services in the background"
    printf "  %-14s %s\n" "stop"    "Stop the stack (flags: --llama --gateway --search --scraper --agent-host --agent --all)"
