cmd_status() {
    echo ""

    if _has_local_inference; then
        local _des_port _des_slots _app_port _app_slots _backend_label
        _des_port="$(_inference_port)"
        _app_port="$(_applied_inference_port)"
        _des_slots=""
        if command -v jq &>/dev/null && [[ -f "$(_settings_file)" ]]; then
            _des_slots="$(jq -r '.inference.parallel_slots // empty' "$(_settings_file)" 2>/dev/null || true)"
        fi
        _app_slots="$(_env_get INFERENCE_PARALLEL)"
        [[ -n "$_app_slots" ]] || _app_slots="$(_env_get LLAMA_PARALLEL)"
        [[ -n "$_app_slots" ]] || _app_slots="$(_env_get STRATA_PARALLEL)"
        # The native backend reads parallel_slots straight from settings.json at
        # start (it has no env applied key), so the applied value is the desired
        # one — fall back to it so a pre-apply box doesn't show '?'.
        if [[ "$NATIVE_INFERENCE" == "true" && -z "$_app_slots" && -n "$_des_slots" ]]; then
            _app_slots="$_des_slots"
        fi
        _backend_label="$(_inference_backend)"
        [[ "$NATIVE_INFERENCE" == "true" ]] && _backend_label="llama-native (Metal)"
        echo -e "${BLUE}── Inference settings ───────────────────────────────${NC}"
        echo "  backend : ${_backend_label}"
        echo "  port    : desired ${_des_port} / applied ${_app_port:-?}"
        echo "  slots   : desired ${_des_slots:-1} / applied ${_app_slots:-?}"
        if _inference_settings_drift; then
            ok "settings.json is applied"
        else
            warn "settings.json differs from applied state — run: openmono start"
        fi
        echo ""
    fi

    if [[ "$NATIVE_INFERENCE" == "true" ]]; then
        native_cmd_status
    elif [[ "$(_inference_backend)" == "strata" ]]; then
        # Strata backend: host-native server + optional gateway containers.
        bash "$REPO_DIR/scripts/strata.sh" status || true

        if docker info &>/dev/null 2>&1; then
            echo ""
            echo -e "${BLUE}── Gateway containers ───────────────────────────────${NC}"
            docker ps \
                --filter "name=openmono-gateway" \
                --filter "name=openmono-agent" \
                --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || true
        fi

        echo ""
        echo -e "${BLUE}── GPU ──────────────────────────────────────────────${NC}"
        if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null 2>&1; then
            nvidia-smi \
                --query-gpu=name,memory.used,memory.total,utilization.gpu \
                --format=csv,noheader,nounits \
                | awk -F', ' '{printf "  %s  VRAM: %s/%s MiB  GPU: %s%%\n", $1, $2, $3, $4}'
        else
            echo "  No NVIDIA GPU detected (Strata also supports AMD — see docs/STRATA.md)"
        fi

        echo ""
        echo -e "${BLUE}── Model ────────────────────────────────────────────${NC}"
        _STRATA_PORT="$(_strata_port)"
        LOADED=$(_inference_curl -sf --max-time 3 "http://localhost:${_STRATA_PORT}/v1/models" \
            | python3 -c "
import sys, json
d = json.load(sys.stdin)
models = d.get('data', [])
print(models[0].get('id', '').strip() if models else '')
" 2>/dev/null || true)
        if [ -n "$LOADED" ]; then
            ok "Model loaded: $LOADED"
        else
            warn "Model not reachable — start Strata with: openmono start"
        fi
        echo ""
        return 0
    else
        _ensure_docker
        if ! docker info &>/dev/null 2>&1; then
            warn "Docker daemon is not accessible — cannot show status"
            if [ "$_OPENMONO_OS" = "Darwin" ]; then
                [ -d "/Applications/Docker.app" ] && warn "Try: open /Applications/Docker.app" \
                    || warn "Try: colima start"
            else
                warn "Try: sudo systemctl start docker"
            fi
            return 1
        fi

        echo -e "${BLUE}── Containers ───────────────────────────────────────${NC}"
        docker ps \
            --filter "name=llama-server" \
            --filter "name=openmono-agent" \
            --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || true

        echo ""
        echo -e "${BLUE}── llama-server health ──────────────────────────────${NC}"
        if _inference_curl -sf "http://localhost:${INFERENCE_PORT}/health" &>/dev/null; then
            ok "http://localhost:${INFERENCE_PORT}/health → OK"
        else
            warn "http://localhost:${INFERENCE_PORT}/health → not responding"
        fi

        echo ""
        echo -e "${BLUE}── GPU ──────────────────────────────────────────────${NC}"
        if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null 2>&1; then
            nvidia-smi \
                --query-gpu=name,memory.used,memory.total,utilization.gpu \
                --format=csv,noheader,nounits \
                | awk -F', ' '{printf "  %s  VRAM: %s/%s MiB  GPU: %s%%\n", $1, $2, $3, $4}'
        else
            HAS_HW=false
            if command -v lspci &>/dev/null && lspci 2>/dev/null | grep -qi 'nvidia'; then
                HAS_HW=true
            elif grep -qi "0x10de" /sys/bus/pci/devices/*/vendor 2>/dev/null; then
                HAS_HW=true
            fi
            if [ "$HAS_HW" = true ]; then
                echo -e "  ${YELLOW}⚠${NC}  NVIDIA hardware detected, but drivers not working/installed"
            else
                echo "  No NVIDIA GPU detected"
            fi
        fi
    fi

    echo ""
    echo -e "${BLUE}── Model ────────────────────────────────────────────${NC}"
    LOADED=""
    LOADED=$(_inference_curl -sf --max-time 3 "http://localhost:${INFERENCE_PORT}/props" \
        | python3 -c "
import sys, json
d = json.load(sys.stdin)
def basename(p): return p.split('/')[-1].replace('.gguf', '').replace('.GGUF', '') if p else ''
name = (d.get('model_alias') or '').strip() \
    or basename((d.get('model_path') or '').strip()) \
    or basename((d.get('default_generation_settings', {}).get('model') or '').strip())
print(name)
" 2>/dev/null || true)
    if [ -z "$LOADED" ]; then
        LOADED=$(_inference_curl -sf --max-time 3 "http://localhost:${INFERENCE_PORT}/v1/models" \
            | python3 -c "
import sys, json
d = json.load(sys.stdin)
models = d.get('data', [])
print(models[0].get('id', '').strip() if models else '')
" 2>/dev/null || true)
    fi

    if [ -n "$LOADED" ]; then
        ok "Model loaded: $LOADED"
    else
        GGUF=$(find "$REPO_DIR/models" -maxdepth 1 -name "*.gguf" 2>/dev/null | head -1)
        if [ -n "$GGUF" ]; then
            SIZE=$(du -h "$GGUF" | cut -f1)
            ok "Model on disk: $(basename "$GGUF") ($SIZE)"
        else
            warn "Model not found — run: openmono setup"
        fi
    fi
    echo ""
}

