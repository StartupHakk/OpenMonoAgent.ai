{
  "_comment": [
    "OpenMono.ai — model + inference-backend catalog.",
    "Single source of truth for the installers (scripts/install.sh, scripts/install_macos.sh)",
    "and scripts/lib/prism.sh. Edit THIS file to add or change a model; you do not need to",
    "touch the shell scripts. Resolved at install time with jq (jq is a hard prerequisite).",
    "If this file is missing or corrupt the installers fall back to embedded defaults in",
    "scripts/lib/model-catalog.sh, so a bad edit can never brick the installer.",
    "",
    "Schema (schema=1):",
    "  default                 id of the model chosen when nothing is specified.",
    "  models[]                one entry per selectable model.",
    "    id                    stable identifier; --model=<id> matches this or any alias.",
    "    backend               'llama' (stock llama.cpp path) or 'strata' (custom script).",
    "    prism                 true => uses the PrismML llama.cpp fork image (Bonsai).",
    "    aliases[]             extra --model= names that select this entry.",
    "    requires              capability flag that must be 1 to offer this model:",
    "                          'CAN_BONSAI' or 'CAN_STRATA', or null for always-available.",
    "    deny                  message printed when an explicit --model=<id> is refused",
    "                          because its 'requires' gate fails.",
    "    menu{label,tag,line}  text shown in the interactive picker ('line' is the exact",
    "                          menu row; label/tag are used when 'line' is absent).",
    "    files{name,url,mmproj,mmproj_url}  model identity when it is fixed across tiers",
    "                          (Bonsai: one GGUF, tiers only change ctx/kv). For tier-varying",
    "                          models (Qwen) the identity lives in each tier instead.",
    "    accuracy              fixed accuracy label for file-identity models (Bonsai).",
    "    label                 fixed picker/download label for file-identity models",
    "                          (tiers[].label wins when a tier row exists).",
    "    script                backend 'strata': path to the manager script to run instead of",
    "                          the llama download path. port_env/port_default name the OpenAI",
    "                          endpoint written to docker/.env.",
    "    platforms{linux,macos}  per-platform tier tables. The tier KEY differs by platform:",
    "                          linux keys on VRAM MB bucket (24/16/12/8/cpu), macOS keys on",
    "                          unified RAM GB (48/32/16/8). Same GGUF can map to a different",
    "                          tier key per platform — that is expected.",
    "      tiers{<key>:{...}}    ctx (tokens), accuracy (full|standard|lower|bonsai-*),",
    "                          optional kv (cache-type-k/v for the GPU override), an optional",
    "                          per-tier label, and, when the file varies per tier,",
    "                          name/url/mmproj/mmproj_url.",
    "      min_mem             macOS-only: minimum unified RAM (GB) required to offer this",
    "                          model (used by install_macos.sh; absent => no extra gate).",
    "  context{linux,macos}    context-reduction constants (mmproj/vision headroom) so they",
    "                          can be tuned here instead of in the scripts."
  ],
  "schema": 1,
  "default": "qwen",
